# Example values only. Django does not load this file automatically.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-private-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web-fizika.uz,www.web-fizika.uz
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://web-fizika.uz,https://www.web-fizika.uz

DJANGO_CSRF_TRUSTED_ORIGINS=https://web-fizika.uz,https://www.web-fizika.uz
