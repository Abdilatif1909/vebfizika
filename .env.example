# Reference template only. Django reads process environment variables; cPanel
# values must be configured in the Python application settings.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-private-random-value
DJANGO_ALLOWED_HOSTS=veb-fizika.uz,www.veb-fizika.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://veb-fizika.uz,https://www.veb-fizika.uz
CORS_ALLOWED_ORIGINS=https://veb-fizika.uz,https://www.veb-fizika.uz

# Keep redirect and HSTS off until HTTPS is verified end to end.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Enable only if Ahost confirms its trusted proxy sets X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False
